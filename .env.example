# TalkDoc - variáveis de ambiente.
# Copie para .env e preencha (o .env NÃO entra no git).
# O `docker compose up` funciona com valores vazios; as chaves são usadas
# pelo pipeline RAG (indexação com Gemini e chat com Groq).

# Chave da API Groq (chat LLM - openai/gpt-oss-120b)
GROQ_API_KEY=

# Chave da API Google Gemini (embeddings - gemini-embedding-001, 768 dims)
GEMINI_API_KEY=

# Origens permitidas no CORS (CSV). Padrão: frontend nginx (8080) e Vite dev (5173)
# CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Overrides opcionais (padrões já são os corretos no compose)
# QDRANT_URL=http://qdrant:6333
# DATABASE_URL=sqlite:////app/data/talkdoc.db
